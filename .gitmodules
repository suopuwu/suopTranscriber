[submodule "third_party/whisper.cpp"]
	path = third_party/whisper.cpp
	url = https://github.com/ggerganov/whisper.cpp.git
[submodule "third_party/llama.cpp"]
	path = third_party/llama.cpp
	url = https://github.com/ggerganov/llama.cpp.git
[submodule "third_party/sherpa-onnx"]
	path = third_party/sherpa-onnx
	# suopuwu fork, not upstream k2-fsa/sherpa-onnx: the pinned commit sits
	# above the v1.13.4 tag (see the patch-guard comment in CMakeLists.txt),
	# and only exists on this fork's history — a plain
	# `git submodule update --init` against upstream can't resolve it.
	url = https://github.com/suopuwu/sherpa-onnx.git
