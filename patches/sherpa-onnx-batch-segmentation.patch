+          out_data + static_cast<size_t>(i) * num_frames * num_classes,
+          out_data + static_cast<size_t>(i + 1) * num_frames * num_classes,
+          &m(0, 0));
+      ans.push_back(std::move(m));
+    }
+    return ans;
+  }
